<?xml version="1.0" encoding="utf-8"?>
<!-- Билд для выкатки: dotnet publish src/UpdateManager.App -p:PublishProfile=win-x64
     Self-contained (рантайм в комплекте), НЕ single-file и без trimming: движок SimplePatchTool
     обновляет установку пофайлово, а DLL движка грузятся рефлексией CLR 2.0-стиля. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>..\..\publish\UpdateManager\</PublishDir>
  </PropertyGroup>
</Project>

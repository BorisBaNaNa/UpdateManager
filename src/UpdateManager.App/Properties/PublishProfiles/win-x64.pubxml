<?xml version="1.0" encoding="utf-8"?>
<!-- Билд для выкатки: dotnet publish src/UpdateManager.App -p:PublishProfile=win-x64
     Результат — в Release/ в корне репозитория: из этой папки UpdateManager собирает патч сам себе.
     Self-contained (рантайм в комплекте), НЕ single-file и без trimming: движок SimplePatchTool
     обновляет установку пофайлово, а DLL движка грузятся рефлексией CLR 2.0-стиля. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\Release\</PublishDir>
  </PropertyGroup>

  <!-- Чистая папка перед каждым publish: движок кладёт в патч всё содержимое папки билда, и
       файлы, исчезнувшие из новой версии, иначе уехали бы к клиентам. Release/ — только под билд,
       ничего своего туда не класть. -->
  <Target Name="CleanReleaseDir" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PublishDir)" />
  </Target>
</Project>

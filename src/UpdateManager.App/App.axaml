<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UpdateManager.App.App"
             RequestedThemeVariant="Default">

    <!-- Дизайн «каталог»: матовая основа, тонкие линии, цвет — только у этапов выпуска.
         Токены темы — здесь; цвета этапов одинаковы в обеих темах (это код, а не оформление). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="GroundBrush" Color="#EFEFED" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#E5E5E3" />
                    <SolidColorBrush x:Key="SelectedBrush" Color="#D6D6D3" />
                    <SolidColorBrush x:Key="InkBrush" Color="#111111" />
                    <SolidColorBrush x:Key="InkInverseBrush" Color="#F4F4F2" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#595957" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#C9C9C6" />
                    <SolidColorBrush x:Key="PendingBrush" Color="#8A8A87" />
                    <SolidColorBrush x:Key="FailedBrush" Color="#C8262B" />

                    <!-- То, что рисует сам Fluent: рамка фокуса (краска поверх фона) и полосы прокрутки
                         (ползунок — серый «ещё не пройден», под указателем темнее, нажат — краска). -->
                    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#111111" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#EFEFED" />
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#8A8A87" />
                    <Color x:Key="ScrollBarThumbBackgroundColor">#8A8A87</Color>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#595957" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#111111" />
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#E5E5E3" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#E5E5E3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="GroundBrush" Color="#111111" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#161616" />
                    <SolidColorBrush x:Key="SelectedBrush" Color="#242424" />
                    <SolidColorBrush x:Key="InkBrush" Color="#F2F2F0" />
                    <SolidColorBrush x:Key="InkInverseBrush" Color="#111111" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#9B9B98" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#2C2C2C" />
                    <SolidColorBrush x:Key="PendingBrush" Color="#686866" />
                    <SolidColorBrush x:Key="FailedBrush" Color="#FF5A4F" />

                    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#F2F2F0" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#111111" />
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#686866" />
                    <Color x:Key="ScrollBarThumbBackgroundColor">#686866</Color>
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#9B9B98" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#F2F2F0" />
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#161616" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#161616" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="StageBuildBrush" Color="#2E86AB" />
            <SolidColorBrush x:Key="StagePatchBrush" Color="#F3B61F" />
            <SolidColorBrush x:Key="StageFilesBrush" Color="#9B5DE5" />
            <SolidColorBrush x:Key="StageDeliveryBrush" Color="#1FA39A" />
            <SolidColorBrush x:Key="StageVerifyBrush" Color="#76B041" />
            <!-- Текст на залитом блоке этапа: тёмный в обеих темах (цвета этапов светлые). -->
            <SolidColorBrush x:Key="StageInkBrush" Color="#111111" />

            <!-- Прямые углы и у стандартных элементов Fluent (меню, подсказки, поля). -->
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#2E86AB" RegionColor="#EFEFED" />
                <ColorPaletteResources x:Key="Dark" Accent="#2E86AB" RegionColor="#111111" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource GroundBrush}" />
        </Style>

        <!-- Ползунок прокрутки — прямоугольник, как всё в «каталоге». -->
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <!-- Текст -->
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.caps">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LetterSpacing" Value="1.6" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.number">
            <Setter Property="FontFeatures" Value="+tnum" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.heading.failed">
            <Setter Property="Foreground" Value="{DynamicResource FailedBrush}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.detail">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Диалоги: поля 24 px, подписи полей приглушены, разделы — под тонкой линией,
             подвал с кнопками — на тоне панели. Главная кнопка одна, остальные — тихие. -->
        <Style Selector="TextBlock.field">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.rule">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
        </Style>
        <Style Selector="Border.footer">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="24,14" />
        </Style>
        <Style Selector="Border.footer Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.footer Button.quiet">
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <!-- Провал словами: тот же код, что у проваленного этапа, — красный контур 2 px. -->
        <Style Selector="Border.failure">
            <Setter Property="BorderBrush" Value="{DynamicResource FailedBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="Border.failure TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FailedBrush}" />
        </Style>
        <!-- Журнал операции: данные, поэтому моноширинный; плоский, на тоне панели. -->
        <Style Selector="TextBox.log">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="TextBox.log /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.log:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        </Style>
        <Style Selector="TextBox.log:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <!-- Кнопки: прямые углы; главная — залитая краской, остальные — тонкий контур. -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource InkBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkInverseBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="22,11" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InkBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkInverseBrush}" />
            <Setter Property="Opacity" Value="0.86" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource InkBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkInverseBrush}" />
            <Setter Property="Opacity" Value="0.72" />
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
        <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PendingBrush}" />
        </Style>
        <Style Selector="Button.quiet:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PendingBrush}" />
        </Style>

        <!-- Каталог: выделение — подложка, без цветных полос. -->
        <Style Selector="ListBox.catalog">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.catalog ListBoxItem">
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="ListBox.catalog ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
        </Style>
        <Style Selector="ListBox.catalog ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>

        <!-- Дерево папок FTP: выделение — та же серая подложка, что в каталоге. -->
        <Style Selector="TreeView.folders TreeViewItem">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TreeView.folders TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
        </Style>
        <Style Selector="TreeView.folders TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
        </Style>
        <Style Selector="TreeView.folders TreeViewItem:selected /template/ Border#PART_LayoutRoot > ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>

        <Style Selector="ListBox.choice ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <!-- Недавний проект, чья папка пропала: приглушён, клик предлагает убрать из списка. -->
        <Style Selector="Button.missing">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- Блок этапа: цвет — этап, заливка — пройден, контур — ещё нет, красный контур — провал. -->
        <Style Selector="Border.stage">
            <Setter Property="BorderBrush" Value="{DynamicResource PendingBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="Border.stage.done">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource StageInkBrush}" />
        </Style>
        <Style Selector="Border.stage.done.build">
            <Setter Property="Background" Value="{StaticResource StageBuildBrush}" />
        </Style>
        <Style Selector="Border.stage.done.patch">
            <Setter Property="Background" Value="{StaticResource StagePatchBrush}" />
        </Style>
        <Style Selector="Border.stage.done.files">
            <Setter Property="Background" Value="{StaticResource StageFilesBrush}" />
        </Style>
        <Style Selector="Border.stage.done.delivery">
            <Setter Property="Background" Value="{StaticResource StageDeliveryBrush}" />
        </Style>
        <Style Selector="Border.stage.done.verify">
            <Setter Property="Background" Value="{StaticResource StageVerifyBrush}" />
        </Style>
        <Style Selector="Border.stage.failed">
            <Setter Property="BorderBrush" Value="{DynamicResource FailedBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource FailedBrush}" />
        </Style>

        <!-- Блок этапа как кнопка: без оформления Fluent, отклик — на самом блоке. -->
        <Style Selector="Button.stagebtn">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Не PART_ContentPresenter: иначе стили Fluent (:disabled, :pointerover) красят фон. -->
                    <ContentPresenter Name="StagePresenter" Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.stagebtn:pointerover">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.stagebtn:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.stagebtn:pointerover Border.stage">
            <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="Button.stagebtn:pointerover Border.stage.done">
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button.stagebtn:pressed Border.stage">
            <Setter Property="Opacity" Value="0.74" />
        </Style>
        <Style Selector="TextBlock.stageaction">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>

        <!-- Мини-полоса в каталоге: тот же код, без текста. -->
        <Style Selector="Border.chip">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PendingBrush}" />
        </Style>
        <Style Selector="Border.chip.done">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.chip.done.build">
            <Setter Property="Background" Value="{StaticResource StageBuildBrush}" />
        </Style>
        <Style Selector="Border.chip.done.patch">
            <Setter Property="Background" Value="{StaticResource StagePatchBrush}" />
        </Style>
        <Style Selector="Border.chip.done.files">
            <Setter Property="Background" Value="{StaticResource StageFilesBrush}" />
        </Style>
        <Style Selector="Border.chip.done.delivery">
            <Setter Property="Background" Value="{StaticResource StageDeliveryBrush}" />
        </Style>
        <Style Selector="Border.chip.done.verify">
            <Setter Property="Background" Value="{StaticResource StageVerifyBrush}" />
        </Style>
        <Style Selector="Border.chip.failed">
            <Setter Property="BorderBrush" Value="{DynamicResource FailedBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Application.Styles>
</Application>

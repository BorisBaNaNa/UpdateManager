<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- UpdateManager 2.0: Avalonia + MVVM поверх UpdateManager.Core. Имя сборки/exe — как у 1.x
         (UpdateManager.exe): по нему движок перезапускает приложение после самообновления. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>UpdateManager</AssemblyName>
    <RootNamespace>UpdateManager.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>UpdateManagerIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Поставка (self-contained win-x64, без single-file) — Properties/PublishProfiles/win-x64.pubxml. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UpdateManager.Core\UpdateManager.Core.csproj" />
    <!-- CompressionFormat (окно настроек) — тип движка; HintPath-ссылки не транзитивны. -->
    <Reference Include="SimplePatchTool">
      <HintPath>..\..\lib\SimplePatchTool.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="UpdateManagerIcon.ico" />
    <!-- Конфиг самообновления: входит в патч, смена сервера разъезжается с обновлением. -->
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Встроенный self-patcher: копируется в SelfPatcher\ рядом с exe, оттуда кладётся
         в каждый создаваемый проект и запускается при самообновлении. -->
    <Content Include="SelfPatcher\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>

<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:UpdateManager.App.ViewModels"
                xmlns:v="using:UpdateManager.App.Views"
                x:Class="UpdateManager.App.Views.FtpBrowserWindow"
                x:DataType="vm:FtpBrowserViewModel"
                Title="Папка на сервере"
                Width="440" Height="520" MinWidth="340" MinHeight="360"
                ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="footer">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Classes="primary" Content="Выбрать"
                        IsDefault="True" Command="{Binding SelectCommand}" />
                <Button Classes="quiet" Content="Отмена"
                        IsCancel="True" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>

        <!-- Строка состояния: пока идёт подключение/загрузка — что именно; иначе — выбранный путь. -->
        <Border DockPanel.Dock="Bottom" Padding="24,10" BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,1,0,0">
            <Panel>
                <TextBlock Classes="muted" Text="{Binding Status}" IsVisible="{Binding IsBusy}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Selected.FullPath, FallbackValue=''}" IsVisible="{Binding !IsBusy}"
                           TextTrimming="PathSegmentEllipsis"
                           ToolTip.Tip="{Binding Selected.FullPath, FallbackValue=''}" />
            </Panel>
        </Border>

        <TreeView Classes="folders" Padding="12,10" ItemsSource="{Binding Roots}"
                  SelectedItem="{Binding Selected}" IsEnabled="{Binding !IsBusy}">
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:FtpFolderNode">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:FtpFolderNode" ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name}" Classes.muted="{Binding !IsFolder}" />
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</v:DialogWindow>

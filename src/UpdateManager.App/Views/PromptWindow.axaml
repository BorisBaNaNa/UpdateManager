<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:UpdateManager.App.ViewModels"
                xmlns:v="using:UpdateManager.App.Views"
                x:Class="UpdateManager.App.Views.PromptWindow"
                x:DataType="vm:PromptViewModel"
                Title="{Binding Title}"
                Width="460" SizeToContent="Height"
                CanResize="False" ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="footer">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Classes="primary" Content="OK"
                        IsDefault="True" Command="{Binding OkCommand}" />
                <Button Classes="quiet" Content="Отмена"
                        IsCancel="True" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,22,24,24" Spacing="12">
            <TextBlock Classes="heading" Text="{Binding Title}" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" LineHeight="21" />
            <TextBox x:Name="ValueBox" Text="{Binding Value}" FontSize="15" />
        </StackPanel>
    </DockPanel>
</v:DialogWindow>

<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:UpdateManager.App.ViewModels"
                xmlns:v="using:UpdateManager.App.Views"
                x:Class="UpdateManager.App.Views.PromptWindow"
                x:DataType="vm:PromptViewModel"
                Title="{Binding Title}"
                Width="420" SizeToContent="Height"
                CanResize="False" ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <TextBox x:Name="ValueBox" Text="{Binding Value}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="OK" MinWidth="80" HorizontalContentAlignment="Center"
                    IsDefault="True" Command="{Binding OkCommand}" />
            <Button Content="Отмена" MinWidth="80" HorizontalContentAlignment="Center"
                    IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</v:DialogWindow>

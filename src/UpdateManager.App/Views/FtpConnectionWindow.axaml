<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:UpdateManager.App.ViewModels"
                xmlns:v="using:UpdateManager.App.Views"
                x:Class="UpdateManager.App.Views.FtpConnectionWindow"
                x:DataType="vm:FtpConnectionViewModel"
                Title="FTP-подключение"
                Width="580" SizeToContent="Height"
                CanResize="False" ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="footer">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="quiet" Content="{Binding TestButtonText}"
                        Command="{Binding TestCommand}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Classes="primary" Content="Сохранить"
                            IsDefault="True" Command="{Binding SaveCommand}" />
                    <Button Classes="quiet" Content="Отмена"
                            IsCancel="True" Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="24,22,24,24">
            <TextBlock Classes="heading" Text="Сервер" />
            <Grid Margin="0,14,0,0" ColumnDefinitions="140,*,16,Auto,10,96"
                  RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Grid.Row="0" Classes="field" Text="Хост" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Host}" PlaceholderText="192.168.0.100" />
                <TextBlock Grid.Row="0" Grid.Column="3" Classes="field" Text="Порт" />
                <NumericUpDown Grid.Row="0" Grid.Column="5" ShowButtonSpinner="False"
                               Minimum="1" Maximum="65535" Increment="1" FormatString="0"
                               Value="{Binding Port}" />

                <TextBlock Grid.Row="1" Classes="field" Text="Пользователь" />
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding Username}" />

                <TextBlock Grid.Row="2" Classes="field" Text="Пароль" />
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding Password}"
                         PasswordChar="●" RevealPassword="False" />
            </Grid>
            <TextBlock Margin="140,8,0,0" Classes="detail"
                       Text="Реквизиты хранятся в профиле пользователя Windows, пароль зашифрован (DPAPI)." />

            <Border Classes="rule" Margin="0,22,0,0" />
            <TextBlock Margin="0,18,0,0" Classes="heading" Text="Папки на сервере" />
            <Grid Margin="0,14,0,0" ColumnDefinitions="140,*,10,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Classes="field" Text="Патчи" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RemotePath}" PlaceholderText="/updates" />
                <Button Grid.Row="0" Grid.Column="3" Classes="quiet" Content="Выбрать…"
                        Command="{Binding BrowseRemoteCommand}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                           Classes="detail" Text="{Binding ComputedPath}" />

                <TextBlock Grid.Row="2" Margin="0,16,0,0" Classes="field" Text="Приватный ключ" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,16,0,0" Text="{Binding PrivateKeyRemotePath}" />
                <Button Grid.Row="2" Grid.Column="3" Margin="0,16,0,0" Classes="quiet" Content="Выбрать…"
                        Command="{Binding BrowsePrivateKeyCommand}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Classes="detail"
                           Text="Отдельная закрытая папка, доступная только команде. Не должна совпадать с папкой патчей: оттуда качают клиенты, а приватный ключ туда попасть не должен. Пусто — ключ на FTP не заливается." />
            </Grid>
        </StackPanel>
    </DockPanel>
</v:DialogWindow>

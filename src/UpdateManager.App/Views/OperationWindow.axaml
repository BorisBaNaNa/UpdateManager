<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:UpdateManager.App.ViewModels"
                xmlns:v="using:UpdateManager.App.Views"
                x:Class="UpdateManager.App.Views.OperationWindow"
                x:DataType="vm:OperationViewModel"
                Title="{Binding Title}"
                Width="640" Height="480" MinWidth="460" MinHeight="320"
                ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner">

    <DockPanel>
        <!-- Пока идёт — тихая «Прервать»; по завершении — главная «Закрыть». -->
        <Border DockPanel.Dock="Bottom" Classes="footer">
            <Button HorizontalAlignment="Right"
                    Classes.primary="{Binding !IsRunning}" Classes.quiet="{Binding IsRunning}"
                    Content="{Binding ButtonText}" Command="{Binding CloseOrCancelCommand}" />
        </Border>

        <DockPanel Margin="24,22,24,24">
            <StackPanel DockPanel.Dock="Top" Spacing="4">
                <TextBlock Classes="heading" Text="{Binding Title}" />
                <TextBlock Classes="muted number" Text="{Binding StateText}" />
            </StackPanel>

            <!-- Два бара вместо переключения IsIndeterminate: при смене true→false Fluent-шаблон
                 продолжал рисовать бегущую полосу. -->
            <Panel DockPanel.Dock="Top" Margin="0,14,0,0" IsVisible="{Binding !IsFailed}">
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsIndeterminate}" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"
                             IsVisible="{Binding !IsIndeterminate}" />
            </Panel>

            <Border DockPanel.Dock="Top" Classes="failure" Margin="0,14,0,0" IsVisible="{Binding IsFailed}">
                <SelectableTextBlock Text="{Binding FailureText}" TextWrapping="Wrap"
                                     Foreground="{DynamicResource FailedBrush}" />
            </Border>

            <!-- Журнал — это данные, поэтому моноширинный; без рамки, на тоне панели. -->
            <TextBox x:Name="LogBox" Margin="0,16,0,0" Text="{Binding LogText}" IsReadOnly="True"
                     Classes="log" AcceptsReturn="True" TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </DockPanel>
    </DockPanel>
</v:DialogWindow>

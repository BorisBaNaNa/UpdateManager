<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:UpdateManager.App.ViewModels"
                xmlns:v="using:UpdateManager.App.Views"
                x:Class="UpdateManager.App.Views.ProjectSettingsWindow"
                x:DataType="vm:ProjectSettingsViewModel"
                Title="Настройки проекта"
                Width="540" Height="720" MinWidth="460" MinHeight="480"
                ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" MinWidth="90" HorizontalContentAlignment="Center"
                    IsDefault="True" Command="{Binding SaveCommand}" />
            <Button Content="Отмена" MinWidth="90" HorizontalContentAlignment="Center"
                    IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Margin="0,0,12,0">
                <Grid ColumnDefinitions="175,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Grid.Row="0" Text="Имя проекта:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" />
                    <TextBlock Grid.Row="1" Text="Адрес сервера:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Server}"
                             PlaceholderText="http://updates.example.com/" />
                    <TextBlock Grid.Row="2" Text="Директория загрузки:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UploadDirectory}"
                             PlaceholderText="MyApp/Output" />
                    <TextBlock Grid.Row="3" Text="MaintenanceCheckURL:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaintenanceCheckUrl}" />
                </Grid>

                <CheckBox Content="Self-patching приложение" IsChecked="{Binding IsSelfPatchingApp}" />
                <CheckBox Content="Подписывать патч RSA-ключом" IsChecked="{Binding SignPatch}" />

                <HeaderedContentControl Classes="group" Header="Типы патчей">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="Repair" IsChecked="{Binding CreateRepairPatch}" />
                            <CheckBox Content="Installer" IsChecked="{Binding CreateInstallerPatch}" />
                            <CheckBox Content="Incremental" IsChecked="{Binding CreateIncrementalPatch}" />
                        </StackPanel>
                        <CheckBox Content="Инкрементальные от каждой предыдущей версии"
                                  IsChecked="{Binding CreateAllIncrementalPatches}" />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Classes="group" Header="Дополнительно">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="175,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="Сжатие Repair:" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="140"
                                      ItemsSource="{Binding CompressionFormats}"
                                      SelectedItem="{Binding CompressionRepair}" />
                            <TextBlock Grid.Row="1" Text="Сжатие Installer:" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="140"
                                      ItemsSource="{Binding CompressionFormats}"
                                      SelectedItem="{Binding CompressionInstaller}" />
                            <TextBlock Grid.Row="2" Text="Сжатие Incremental:" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" MinWidth="140"
                                      ItemsSource="{Binding CompressionFormats}"
                                      SelectedItem="{Binding CompressionIncremental}" />
                            <TextBlock Grid.Row="3" Text="BinaryDiffQuality:" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Width="140" HorizontalAlignment="Left"
                                           Minimum="0"
                                           Maximum="9"
                                           Increment="1" FormatString="0"
                                           Value="{Binding BinaryDiffQuality}" />
                        </Grid>
                        <CheckBox Content="Не создавать патч-файлы для неизменённых файлов"
                                  IsChecked="{Binding DontCreatePatchFilesForUnchangedFiles}" />
                    </StackPanel>
                </HeaderedContentControl>

                <TextBlock Text="Игнорируемые пути (по одному в строке):" />
                <TextBox Text="{Binding IgnoredPaths}" AcceptsReturn="True" Height="120"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</v:DialogWindow>

<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:UpdateManager.App.ViewModels"
                xmlns:v="using:UpdateManager.App.Views"
                x:Class="UpdateManager.App.Views.MessageWindow"
                x:DataType="vm:MessageViewModel"
                Title="{Binding Title}"
                Width="480" SizeToContent="Height" MaxHeight="640"
                CanResize="False" ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="footer">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Classes="primary" Content="{Binding OkText}"
                        IsDefault="True" Command="{Binding OkCommand}" />
                <Button Classes="quiet" Content="Нет"
                        IsCancel="True" IsVisible="{Binding IsQuestion}" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>

        <!-- Вид сообщения — словами в заголовке; ошибка — красным, как проваленный этап. -->
        <DockPanel Margin="24,22,24,24">
            <TextBlock DockPanel.Dock="Top" Classes="heading" Text="{Binding Title}"
                       Classes.failed="{Binding IsError}" Margin="0,0,0,10" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" LineHeight="21" />
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</v:DialogWindow>

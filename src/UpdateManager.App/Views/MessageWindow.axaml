<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:UpdateManager.App.ViewModels"
                xmlns:v="using:UpdateManager.App.Views"
                x:Class="UpdateManager.App.Views.MessageWindow"
                x:DataType="vm:MessageViewModel"
                Title="{Binding Title}"
                Width="460" SizeToContent="Height" MaxHeight="640"
                CanResize="False" ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding OkText}" MinWidth="80" HorizontalContentAlignment="Center"
                    IsDefault="True" Command="{Binding OkCommand}" />
            <Button Content="Нет" MinWidth="80" HorizontalContentAlignment="Center"
                    IsCancel="True" IsVisible="{Binding IsQuestion}" Command="{Binding CancelCommand}" />
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="26" Margin="0,0,14,0"
                       VerticalAlignment="Top" />
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</v:DialogWindow>

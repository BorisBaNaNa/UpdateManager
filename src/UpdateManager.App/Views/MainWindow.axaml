<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UpdateManager.App.ViewModels"
        xmlns:svc="using:UpdateManager.App.Services"
        xmlns:views="using:UpdateManager.App.Views"
        x:Class="UpdateManager.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://UpdateManager/UpdateManagerIcon.ico"
        Width="1100" Height="700" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Мини-полоса этапов одной платформы (каталог, недавние проекты). -->
        <DataTemplate x:Key="ChipStrip" x:DataType="vm:PlatformTrack">
            <ItemsControl ItemsSource="{Binding Stages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StageItem">
                        <Border Classes="chip"
                                Classes.build="{Binding IsBuild}" Classes.patch="{Binding IsPatch}"
                                Classes.files="{Binding IsFiles}" Classes.delivery="{Binding IsDelivery}"
                                Classes.verify="{Binding IsVerify}"
                                Classes.done="{Binding IsDone}" Classes.failed="{Binding IsFailed}"
                                ToolTip.Tip="{Binding ToolTipText}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- Полоса этапов одной платформы крупными подписанными блоками; при двух платформах — с подписью. -->
        <DataTemplate x:Key="StageBlocks" x:DataType="vm:PlatformTrack">
            <StackPanel Margin="0,0,0,6">
                <TextBlock Classes="muted number" FontSize="14" Margin="0,4,0,8" Text="{Binding Caption}"
                           IsVisible="{Binding ShowCaption}" />
                <ItemsControl ItemsSource="{Binding Stages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <views:StageGrid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StageItem">
                            <!-- Блок — кнопка: в текущем выпуске платформы пройденный или следующий этап можно (пере)выполнить. -->
                            <Button Classes="stagebtn"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RunStageCommand, FallbackValue={x:Null}}"
                                    CommandParameter="{Binding}">
                                <Border Classes="stage" Padding="14,12" MinHeight="112"
                                        Classes.build="{Binding IsBuild}" Classes.patch="{Binding IsPatch}"
                                        Classes.files="{Binding IsFiles}" Classes.delivery="{Binding IsDelivery}"
                                        Classes.verify="{Binding IsVerify}"
                                        Classes.done="{Binding IsDone}" Classes.failed="{Binding IsFailed}"
                                        ToolTip.Tip="{Binding ToolTipText}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Classes="stageaction" Margin="0,8,0,0"
                                                   Text="{Binding ActionText}"
                                                   IsVisible="{Binding $parent[Button].IsEffectivelyEnabled}" />
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Classes="number" Text="{Binding Detail}" FontSize="12"
                                                       TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Проект">
                <MenuItem Header="Создать проект…" Command="{Binding CreateProjectCommand}" />
                <MenuItem Header="Открыть проект…" Command="{Binding OpenProjectCommand}" />
                <Separator />
                <MenuItem Header="Недавние" Classes="recent" ItemsSource="{Binding RecentProjects}">
                    <MenuItem.Styles>
                        <Style Selector="MenuItem.recent MenuItem" x:DataType="vm:RecentProjectItem">
                            <Setter Property="Header" Value="{Binding Path}" />
                            <Setter Property="Command" Value="{Binding OpenCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding Path}" />
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <Separator />
                <MenuItem Header="Настройки проекта…" Command="{Binding EditSettingsCommand}" />
                <MenuItem Header="Открыть в проводнике" Command="{Binding OpenInExplorerCommand}" />
                <Separator />
                <MenuItem Header="Выход" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="Выпуск">
                <MenuItem Header="Папка билда…" Command="{Binding BrowseBuildSourceCommand}" />
                <MenuItem Header="Главный exe…" Command="{Binding PickMainExecutableCommand}" />
                <Separator />
                <MenuItem Header="Создать патч" Command="{Binding CreatePatchCommand}" />
                <MenuItem Header="Доставить" Command="{Binding DeliverCommand}" />
                <MenuItem Header="Проверить" Command="{Binding VerifyCommand}" />
                <Separator IsVisible="{Binding IsAndroidEnabled}" />
                <MenuItem Header="Папка Android…" IsVisible="{Binding IsAndroidEnabled}"
                          Command="{Binding BrowseAndroidBuildCommand}" />
                <MenuItem Header="Подписать файлы Android" IsVisible="{Binding IsAndroidEnabled}"
                          Command="{Binding SignAndroidCommand}" />
                <MenuItem Header="Доставить Android" IsVisible="{Binding IsAndroidEnabled}"
                          Command="{Binding DeliverAndroidCommand}" />
                <MenuItem Header="Проверить Android" IsVisible="{Binding IsAndroidEnabled}"
                          Command="{Binding VerifyAndroidCommand}" />
                <Separator />
                <MenuItem Header="FTP-сервер…" Command="{Binding ConfigureFtpCommand}" />
            </MenuItem>
            <MenuItem Header="Безопасность">
                <MenuItem Header="Сгенерировать RSA-ключи…" Command="{Binding GenerateKeysCommand}" />
            </MenuItem>
            <MenuItem Header="Вид">
                <MenuItem Header="Светлая тема" ToggleType="Radio" GroupName="theme"
                          IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.Light}" />
                <MenuItem Header="Тёмная тема" ToggleType="Radio" GroupName="theme"
                          IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.Dark}" />
                <MenuItem Header="Как в Windows" ToggleType="Radio" GroupName="theme"
                          IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.System}" />
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="Что нового…" Command="{Binding SelfUpdate.ShowReleaseNotesCommand}" />
                <MenuItem Header="Проверить обновления…" Command="{Binding SelfUpdate.CheckCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Classes="rule" />

        <Grid ColumnDefinitions="280,*">
            <!-- ===== Левая колонка: недавние проекты или каталог выпусков ===== -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
                <Panel>
                    <DockPanel IsVisible="{Binding IsStartScreen}">
                        <TextBlock DockPanel.Dock="Top" Classes="caps" Text="НЕДАВНИЕ ПРОЕКТЫ" Margin="20,24,20,12" />
                        <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="20,0"
                                   IsVisible="{Binding !HasRecentCards}"
                                   Text="Здесь появятся проекты, которые вы создали или открыли." />
                        <ListBox Classes="catalog" ItemsSource="{Binding RecentCards}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentProjectCard">
                                    <Button Background="Transparent" BorderThickness="0" Padding="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Classes.missing="{Binding IsMissing}"
                                            Command="{Binding OpenCommand}" CommandParameter="{Binding Path}"
                                            ToolTip.Tip="{Binding Path}">
                                        <!-- Правый клик: открыть, убрать из показа, удалить с содержимым. -->
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Открыть" Command="{Binding OpenCommand}"
                                                          CommandParameter="{Binding Path}" />
                                                <MenuItem Header="Убрать из списка" Command="{Binding RemoveCommand}"
                                                          CommandParameter="{Binding Path}" />
                                                <Separator />
                                                <MenuItem Header="Удалить проект…" Command="{Binding DeleteCommand}"
                                                          CommandParameter="{Binding Path}" IsEnabled="{Binding CanDelete}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Spacing="3">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="15"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <ItemsControl Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                                              ItemsSource="{Binding LastRelease.Platforms, FallbackValue={x:Null}}"
                                                              ItemTemplate="{StaticResource ChipStrip}" />
                                            </Grid>
                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Path}"
                                                       TextTrimming="PathSegmentEllipsis" />
                                            <TextBlock Classes="muted number" FontSize="12" Margin="0,2,0,0"
                                                       TextWrapping="Wrap" Text="{Binding Summary}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <DockPanel IsVisible="{Binding HasProject}">
                        <StackPanel DockPanel.Dock="Top" Margin="20,22,20,14" Spacing="2">
                            <TextBlock Text="{Binding ProjectName}" FontSize="17" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding ProjectPath}"
                                       TextTrimming="PathSegmentEllipsis" ToolTip.Tip="{Binding ProjectPath}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="caps" Text="ВЫПУСКИ" Margin="20,10,20,8" />
                        <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="20,4" TextWrapping="Wrap"
                                   IsVisible="{Binding !HasReleases}" Text="Пока пусто." />
                        <ListBox Classes="catalog" ItemsSource="{Binding Releases}"
                                 SelectedItem="{Binding SelectedRelease}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReleaseItem">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Classes="number" Text="{Binding Version}" FontSize="15" />
                                            <TextBlock Classes="muted number" FontSize="12" Text="{Binding CatalogLine}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <ItemsControl Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                                      ItemsSource="{Binding Platforms}"
                                                      ItemTemplate="{StaticResource ChipStrip}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Panel>
            </Border>

            <!-- ===== Правая колонка ===== -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                <!-- Колонка тянется до 980 и не «гуляет» между состояниями. -->
                <Grid Margin="44,32,44,36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="980" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Стартовый экран: главный элемент — последний проект. -->
                    <StackPanel Grid.Column="0" IsVisible="{Binding IsStartScreen}">
                        <StackPanel IsVisible="{Binding HasFeaturedRecent}">
                            <TextBlock Text="{Binding FeaturedRecent.Title, FallbackValue=''}" FontSize="56"
                                       LetterSpacing="-1.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted number" FontSize="14" Margin="0,4,0,0"
                                       Text="{Binding FeaturedRecent.Summary, FallbackValue=''}" />
                            <TextBlock Classes="muted" FontSize="12" Margin="0,2,0,0" TextTrimming="PathSegmentEllipsis"
                                       Text="{Binding FeaturedRecent.Path, FallbackValue=''}" />
                            <ItemsControl Margin="0,24,0,0"
                                          ItemsSource="{Binding FeaturedRecent.LastRelease.Platforms, FallbackValue={x:Null}}"
                                          ItemTemplate="{StaticResource StageBlocks}" />
                            <WrapPanel Margin="0,20,0,0">
                                <Button Classes="primary" Content="Открыть" Margin="0,0,10,10"
                                        Command="{Binding OpenRecentCommand}"
                                        CommandParameter="{Binding FeaturedRecent.Path, FallbackValue=''}" />
                                <Button Classes="quiet" Padding="16,10" Margin="0,0,10,10" Content="Открыть другой…"
                                        Command="{Binding OpenProjectCommand}" />
                                <Button Classes="quiet" Padding="16,10" Margin="0,0,10,10" Content="Создать проект…"
                                        Command="{Binding CreateProjectCommand}" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding !HasFeaturedRecent}">
                            <TextBlock Text="Первый проект" FontSize="56" LetterSpacing="-1.5" />
                            <TextBlock Classes="muted" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Проект обновлений хранит версии, собранные патчи и настройки доставки одного приложения." />
                            <WrapPanel Margin="0,28,0,0">
                                <Button Classes="primary" Content="Создать проект…" Margin="0,0,10,10"
                                        Command="{Binding CreateProjectCommand}" />
                                <Button Classes="quiet" Padding="16,10" Margin="0,0,10,10" Content="Открыть проект…"
                                        Command="{Binding OpenProjectCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Проект открыт: выбранный выпуск. -->
                    <StackPanel Grid.Column="0" IsVisible="{Binding HasProject}">
                        <!-- Номер версии — единственный заголовок; платформа и номер выпуска — сбоку. -->
                        <WrapPanel IsVisible="{Binding HasReleases}">
                            <TextBlock Classes="number" Text="{Binding SelectedRelease.Version, FallbackValue=''}"
                                       FontSize="72" LetterSpacing="-2" Margin="0,0,20,0" />
                            <TextBlock Classes="muted" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,14"
                                       IsVisible="{Binding !SelectedRelease.IsMultiPlatform, FallbackValue=True}"
                                       Text="{Binding SelectedRelease.Kicker, FallbackValue=''}" />
                            <!-- Две платформы: имена — переключатель полосы (и свайп по полосе). -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,14" Spacing="14"
                                        IsVisible="{Binding SelectedRelease.IsMultiPlatform, FallbackValue=False}">
                                <ItemsControl ItemsSource="{Binding SelectedRelease.Platforms, FallbackValue={x:Null}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="14" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlatformTrack">
                                            <Button Classes="platformtab" Classes.selected="{Binding IsSelected}"
                                                    Content="{Binding Platform}" ToolTip.Tip="{Binding Caption}"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectTrackCommand, FallbackValue={x:Null}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="muted" FontSize="14"
                                           Text="{Binding SelectedRelease.KickerTail, FallbackValue=''}" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock IsVisible="{Binding !HasReleases}" Text="Первый выпуск" FontSize="56"
                                   LetterSpacing="-1.5" />

                        <!-- Одна полоса — выбранной платформы; вторая въезжает из-за правого края (свайп, клик по имени). -->
                        <Carousel x:Name="TrackCarousel" Margin="0,24,0,0" ClipToBounds="True"
                                  ItemsSource="{Binding SelectedRelease.Platforms, FallbackValue={x:Null}}"
                                  SelectedItem="{Binding SelectedTrack}"
                                  ItemTemplate="{StaticResource StageBlocks}">
                            <Carousel.PageTransition>
                                <PageSlide Duration="0:0:0.25" Orientation="Horizontal"
                                           SlideInEasing="QuadraticEaseOut" SlideOutEasing="QuadraticEaseOut" />
                            </Carousel.PageTransition>
                        </Carousel>

                        <!-- Следующий шаг -->
                        <WrapPanel Margin="0,18,0,0">
                            <Button Classes="primary" Content="{Binding NextStepText}" Margin="0,0,18,10"
                                    IsVisible="{Binding HasNextStep}" Command="{Binding NextStepCommand}" />
                            <TextBlock Classes="muted" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="640" Margin="0,0,0,10" Text="{Binding StatusText}" />
                        </WrapPanel>

                        <!-- Сведения о проекте: подпись · значение · действие -->
                        <Border Classes="rule" Margin="0,22,0,6" />
                        <Grid ColumnDefinitions="150,*,128" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                            <Grid.Styles>
                                <Style Selector="Grid > TextBlock">
                                    <Setter Property="Margin" Value="0,11" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                                <Style Selector="Grid > TextBlock.value">
                                    <Setter Property="TextTrimming" Value="PathSegmentEllipsis" />
                                    <Setter Property="Margin" Value="0,11,16,11" />
                                    <Setter Property="ToolTip.Tip" Value="{Binding $self.Text}" />
                                </Style>
                                <Style Selector="Grid > Button">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </Grid.Styles>

                            <!-- Windows: папка билда и главный exe; Android: своя папка билда. -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="muted" Text="Папка билда"
                                       IsVisible="{Binding IsWindowsEnabled}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding BuildSource}"
                                       IsVisible="{Binding IsWindowsEnabled}" />
                            <Button Grid.Row="0" Grid.Column="2" Classes="quiet" Content="Выбрать…"
                                    IsVisible="{Binding IsWindowsEnabled}" Command="{Binding BrowseBuildSourceCommand}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="muted" Text="Главный exe"
                                       IsVisible="{Binding IsWindowsEnabled}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value number" Text="{Binding MainExecutableText}"
                                       IsVisible="{Binding IsWindowsEnabled}" />
                            <Button Grid.Row="1" Grid.Column="2" Classes="quiet" Content="Выбрать…"
                                    IsVisible="{Binding IsWindowsEnabled}" Command="{Binding PickMainExecutableCommand}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="muted" Text="Папка Android"
                                       IsVisible="{Binding IsAndroidEnabled}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding AndroidBuildSource}"
                                       IsVisible="{Binding IsAndroidEnabled}" />
                            <Button Grid.Row="2" Grid.Column="2" Classes="quiet" Content="Выбрать…"
                                    IsVisible="{Binding IsAndroidEnabled}" Command="{Binding BrowseAndroidBuildCommand}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="muted" Text="Сервер" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding ServerText}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Row="3" Grid.Column="2" Classes="quiet" Content="Настройки…"
                                    Command="{Binding EditSettingsCommand}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Classes="muted" Text="Доставка" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Classes="value" Text="{Binding DeliveryText}" />
                            <Button Grid.Row="4" Grid.Column="2" Classes="quiet" Content="Настроить…"
                                    Command="{Binding ConfigureDeliveryCommand}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Classes="muted" Text="Папка проекта" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Classes="value" Text="{Binding ProjectPath}" />
                            <Button Grid.Row="5" Grid.Column="2" Classes="quiet" Content="Открыть"
                                    Command="{Binding OpenInExplorerCommand}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>

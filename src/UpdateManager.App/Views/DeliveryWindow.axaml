<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:UpdateManager.App.ViewModels"
                xmlns:v="using:UpdateManager.App.Views"
                x:Class="UpdateManager.App.Views.DeliveryWindow"
                x:DataType="vm:DeliveryViewModel"
                Title="Доставка патча"
                Width="540" SizeToContent="Height"
                CanResize="False" ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="footer">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Classes="primary" Content="{Binding ActionText}"
                        IsDefault="True" Command="{Binding DeliverCommand}" />
                <Button Classes="quiet" Content="Отмена"
                        IsCancel="True" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,22,24,24">
            <TextBlock Classes="heading" Text="Куда доставлять патч" />

            <!-- Методов два — строки, как в каталоге, а не выпадающий список; подложка выделения
                 выходит в поле на 12 px, текст стоит по краю заголовка. -->
            <Border Margin="-12,14,-12,0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                <ListBox Classes="catalog choice" ItemsSource="{Binding Methods}"
                         SelectedItem="{Binding SelectedMethod}" />
            </Border>

            <Grid Margin="0,18,0,0" ColumnDefinitions="Auto,12,*,10,Auto" IsVisible="{Binding !IsFtp}">
                <TextBlock Grid.Column="0" Classes="field" Text="Папка" />
                <TextBox Grid.Column="2" Text="{Binding Path}" PlaceholderText="D:\Server\MyApp" />
                <Button Grid.Column="4" Classes="quiet" Content="Выбрать…"
                        Command="{Binding BrowseCommand}" />
            </Grid>

            <TextBlock Margin="0,18,0,0" Classes="detail" IsVisible="{Binding IsFtp}"
                       Text="Сервер, логин и папка на сервере — в меню «Выпуск → FTP-сервер…». Если они не заданы, окно реквизитов откроется само." />
        </StackPanel>
    </DockPanel>
</v:DialogWindow>

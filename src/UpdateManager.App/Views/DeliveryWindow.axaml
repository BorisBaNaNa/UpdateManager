<v:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:UpdateManager.App.ViewModels"
                xmlns:v="using:UpdateManager.App.Views"
                x:Class="UpdateManager.App.Views.DeliveryWindow"
                x:DataType="vm:DeliveryViewModel"
                Title="Доставка патча"
                Width="520" SizeToContent="Height"
                CanResize="False" ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16" Spacing="10">
        <Grid ColumnDefinitions="130,*,6,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="Метод доставки:" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" />

            <TextBlock Grid.Row="1" Text="{Binding PathLabel}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PathText}"
                     IsEnabled="{Binding !IsFtp}" />
            <Button Grid.Row="1" Grid.Column="3" Content="…" Width="40"
                    Command="{Binding BrowseCommand}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Доставить" MinWidth="90" HorizontalContentAlignment="Center"
                    IsDefault="True" Command="{Binding DeliverCommand}" />
            <Button Content="Отмена" MinWidth="90" HorizontalContentAlignment="Center"
                    IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</v:DialogWindow>

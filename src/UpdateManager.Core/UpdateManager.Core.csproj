<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Доменный слой: проекты, сборка/проверка патча, доставка, подпись, самообновление.
         Про UI не знает. Перенесён из 1.x (ветка v1, UpdateManager/Core) почти без изменений.
         -windows: инструмент только под Windows (DPAPI, SelfPatcher.exe). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>UpdateManager.Core</RootNamespace>
    <!-- Код перенесён из C# 7.3 / .NET Framework — nullable-разметки в нём нет. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Движок SimplePatchTool (CLR 2.0) — грузится в .NET 10 как есть. -->
    <Reference Include="SimplePatchTool">
      <HintPath>..\..\lib\SimplePatchTool.dll</HintPath>
    </Reference>
    <Reference Include="SimplePatchToolSecurity">
      <HintPath>..\..\lib\SimplePatchToolSecurity.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Та же версия, что была вендорена в 1.x (lib/FluentFTP.dll под net472). -->
    <PackageReference Include="FluentFTP" Version="52.1.0" />
    <!-- DPAPI (SecretProtector): ftp.xml от 1.x читается как есть. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <!-- SimplePatchToolSecurity подписывает/проверяет через SignedXml. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UpdateManager.Tests" />
  </ItemGroup>
</Project>

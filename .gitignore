# RSA-ключи подписи патчей — приватный ключ СЕКРЕТ, не коммитить (страховка: ключи живут
# в папке проекта обновления, а не в дев-репо, но на случай тестовых проектов внутри репо).
*.key

# Билд для выкатки (dotnet publish -p:PublishProfile=win-x64) — из него собираются патчи
/Release/

# Дизайн-скилл Impeccable: в репо — брифы экранов (surfaces/) и design.json; эскизы выбора,
# скриншоты ревью и локальное состояние страницы выбора — нет.
/.impeccable/mocks/
/.impeccable/review/
/.impeccable/questions/
/.impeccable/build/
/.impeccable/config.local.json

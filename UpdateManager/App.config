<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- Самообновление: манифест патчей самого UpdateManager. Пусто = выключено. -->
        <add key="SelfUpdate.VersionInfoUrl" value="http://updates.borealis-soft-home/UpdateManager/VersionInfo.info" />
        <!-- RSA-XML публичного ключа (содержимое public.key проекта). Пусто = без проверки подписи. -->
        <add key="SelfUpdate.PublicKey" value="" />
    </appSettings>
</configuration>
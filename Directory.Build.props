<Project>
  <!-- Общие свойства 2.0 (src/ и tests/). Старый WinForms-проект UpdateManager/ — классический csproj
       без генерации AssemblyInfo, эти свойства на него не влияют.

       Product/Company — по ним SelfIdentity узнаёт билд самого UpdateManager (FileVersionInfo
       exe в папке билда) и предлагает пресет самообновления. Совпадают с 1.x. -->
  <PropertyGroup>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <Product>UpdateManager</Product>
    <Company>BorealisSoft</Company>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>
</Project>

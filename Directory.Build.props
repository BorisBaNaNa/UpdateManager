<Project>
  <!-- Общие свойства всех проектов (src/ и tests/).

       Product/Company — по ним SelfIdentity узнаёт билд самого UpdateManager (FileVersionInfo
       exe в папке билда) и предлагает пресет самообновления. Совпадают с 1.x. -->
  <PropertyGroup>
    <Version>2.4.0</Version>
    <FileVersion>2.4.0.0</FileVersion>
    <Product>UpdateManager</Product>
    <Company>BorealisSoft</Company>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>
</Project>
